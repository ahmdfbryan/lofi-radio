# Token bot dari https://discord.com/developers/applications
DISCORD_TOKEN=isi_token_bot_kamu

# ID server (guild) tempat bot akan join
GUILD_ID=isi_guild_id

# ID voice channel tempat bot akan standby 24 jam
VOICE_CHANNEL_ID=isi_voice_channel_id

# Mode audio: "local" (memutar file mp3 di folder ./music secara looping/acak)
# atau "stream" (memutar dari URL internet radio / live stream, misal Icecast/Shoutcast)
MODE=local

# Hanya dipakai jika MODE=stream. Isi dengan URL stream audio langsung (.mp3/.aac/.ogg)
STREAM_URL=

# Volume default (0.0 - 2.0)
VOLUME=0.5
